<Project>
  <!--
    The PckPacker package only handles images and JSON, and skips packing entirely when it sees anything else.
    Godot scenes (.tscn) therefore live outside the packed folder, in WeaverScenes/, and this step appends them to
    the packed .pck as plain files under res://Weaver/scenes/ (the game loads text scenes from .pck files itself).
  -->
  <ItemGroup>
    <PckExtraFile Include="WeaverScenes/**/*.tscn" PckPath="$(MSBuildProjectName)/scenes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <UsingTask TaskName="AppendToPck" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PckFile ParameterType="System.String" Required="true" />
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Godot PCK v3: header (file base at 24, directory offset at 32), file data, then the directory:
        // count, then per file: padded path length + path, offset from file base, size, md5, flags.
        const int Alignment = 32;
        byte[] pck = File.ReadAllBytes(PckFile);
        if (Encoding.ASCII.GetString(pck, 0, 4) != "GDPC" || BitConverter.ToUInt32(pck, 4) != 3)
        {
            Log.LogError("AppendToPck: " + PckFile + " is not a version 3 Godot pack.");
            return false;
        }
        long fileBase = (long)BitConverter.ToUInt64(pck, 24);
        int dirOffset = (int)BitConverter.ToUInt64(pck, 32);

        int count = BitConverter.ToInt32(pck, dirOffset);
        var entries = new List<byte[]>();
        int pos = dirOffset + 4;
        for (int i = 0; i < count; i++)
        {
            int pathLen = BitConverter.ToInt32(pck, pos);
            int entryLen = 4 + pathLen + 8 + 8 + 16 + 4;
            var existing = new byte[entryLen];
            Array.Copy(pck, pos, existing, 0, entryLen);
            entries.Add(existing);
            pos += entryLen;
        }

        Action<Stream, byte[]> write = (stream, bytes) => stream.Write(bytes, 0, bytes.Length);
        using var md5 = MD5.Create();
        using var output = new MemoryStream();
        output.Write(pck, 0, dirOffset);

        foreach (var item in Files)
        {
            byte[] data = File.ReadAllBytes(item.ItemSpec);
            while (output.Length % Alignment != 0) output.WriteByte(0);
            long offset = output.Length - fileBase;
            output.Write(data, 0, data.Length);

            byte[] path = Encoding.UTF8.GetBytes(item.GetMetadata("PckPath").Replace('\\', '/'));
            int padded = (path.Length + 3) / 4 * 4;
            using var entry = new MemoryStream();
            write(entry, BitConverter.GetBytes(padded));
            write(entry, path);
            write(entry, new byte[padded - path.Length]);
            write(entry, BitConverter.GetBytes(offset));
            write(entry, BitConverter.GetBytes((long)data.Length));
            write(entry, md5.ComputeHash(data));
            write(entry, BitConverter.GetBytes(0));
            entries.Add(entry.ToArray());
        }

        while (output.Length % Alignment != 0) output.WriteByte(0);
        long newDirOffset = output.Length;
        write(output, BitConverter.GetBytes(entries.Count));
        foreach (var entry in entries) write(output, entry);

        byte[] result = output.ToArray();
        BitConverter.GetBytes(newDirOffset).CopyTo(result, 32);
        File.WriteAllBytes(PckFile, result);
        Log.LogMessage(MessageImportance.High, "Appended " + Files.Length + " file(s) to " + PckFile);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="AppendScenesToPck" AfterTargets="PackPck" BeforeTargets="CopyQuickPck"
          Condition="Exists('$(PckPackerOutputPath)') And '$(PckPackerSkipped)' != 'true' And '@(PckExtraFile)' != ''">
    <AppendToPck PckFile="$(PckPackerOutputPath)" Files="@(PckExtraFile)" />
  </Target>
</Project>
